{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocketjs.idf.hello",
  "name": "pocketjs-idf-hello",
  "title": "PocketJS-IDF Hello",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked"
      ]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "hello",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          320,
          180
        ],
        "presentation": "fit"
      }
    }
  }
}
